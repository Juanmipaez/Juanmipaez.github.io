---
import Icon from './Icon.astro';
import { site } from '../data/site';
import { langFromPath, useT } from '../i18n';
const lang = langFromPath(Astro.url.pathname);
const t = useT(lang);
const year = new Date().getFullYear();
const cv = site.cv[lang];
---
<footer class="site-footer" id="contact">
  <div class="container footer-inner">
    <span>© {year} {site.name} · UNAL</span>
    <nav class="footer-links" aria-label={t('footer.aria')}>
      <a href={site.links.github} target="_blank" rel="noopener noreferrer"><Icon name="github" size={15} />github</a>
      <a href={site.links.linkedin} target="_blank" rel="noopener noreferrer"><Icon name="linkedin" size={14} />linkedin</a>
      <a href={cv} download={cv.split('/').pop()}><Icon name="file" size={15} />{t('footer.cv')}</a>
      <a href={`mailto:${site.email}`}><Icon name="mail" size={15} />{site.email}</a>
    </nav>
  </div>
</footer>
