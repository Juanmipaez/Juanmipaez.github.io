---
import { site } from '../data/site';
import { href, useT, type Lang } from '../i18n';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useT(lang);
// Strings the animation script shows (captions, buttons, canvas label).
const heroStrings = {
  cap1: t('hero.cap1'), act1: t('hero.act1'),
  cap2: t('hero.cap2'), act2: t('hero.act2'),
  split: t('hero.split'),
  torus: t('hero.torus'), mobius: t('hero.mobius'), twisting: t('hero.twisting'),
};
---
<section class="hero" data-hero data-strings={JSON.stringify(heroStrings)} aria-label={lang === 'es' ? 'Introducción' : 'Introduction'}>
  <div class="hero-copy">
    <h1>{t('hero.hi')} {site.nickname}. {site.tagline[lang]}</h1>
    <p class="hero-lead">
      {site.name}, {t('hero.lead')}
    </p>
    <div class="hero-links">
      <a href={href(lang, '/projects')}>{t('nav.projects')} →</a>
      <a href={href(lang, '/library')}>{t('nav.library')} →</a>
      <a href={href(lang, '/about')}>{t('hero.aboutLink')}</a>
    </div>
  </div>

  <div class="hero-figure">
    <div class="stage" data-stage>
      <canvas aria-label={t('hero.canvas')} role="img"></canvas>

      <div class="term" data-term aria-hidden="true">
        <div class="term-bar">
          <span class="term-dots"><span></span><span></span><span></span></span>
          <span>juanmi@unal: ~</span>
          <span data-term-badge>01</span>
        </div>
        <div class="term-body">
          <div class="term-line"><span class="term-prompt">$</span><span data-term-cmd></span><span class="term-cursor"></span></div>
          <div class="term-out" data-term-out><span class="term-ok">[ok]</span> <span data-term-out-text></span></div>
        </div>
      </div>

      <div class="hud" data-hud>
        <span class="hud-caption" data-caption></span>
        <button type="button" class="hud-btn" data-action>{t('hero.act1')}</button>
      </div>
    </div>

    <div class="modes" role="tablist" aria-label={t('hero.modes')}>
      <button type="button" class="mode active" role="tab" aria-selected="true" data-mode="mobius">
        <span>{t('hero.mode1')}</span><span class="dot" aria-hidden="true"></span>
      </button>
      <button type="button" class="mode" role="tab" aria-selected="false" data-mode="ascii">
        <span>{t('hero.mode2')}</span><span class="dot" aria-hidden="true"></span>
      </button>
    </div>
    <div class="modes-foot">
      <span>{t('hero.drag')}</span>
      <button type="button" class="replay" data-replay>{t('hero.replay')}</button>
    </div>
  </div>
</section>

<script>
  import { initHero } from '../scripts/hero';
  const el = document.querySelector<HTMLElement>('[data-hero]');
  if (el) initHero(el);
</script>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 470px);
    align-items: center;
    gap: 44px;
    padding: 58px 0 54px;
    border-bottom: 1px solid var(--rule);
  }
  h1 {
    margin: 0 0 18px;
    font-size: clamp(2rem, 3.6vw, 2.75rem);
    font-weight: 600;
    line-height: 1.16;
    letter-spacing: -0.025em;
  }
  :global([data-theme='terminal']) h1 { font-size: clamp(1.55rem, 2.7vw, 2.05rem); line-height: 1.28; }
  .hero-lead { margin: 0 0 26px; color: var(--muted); font-size: 1.06rem; line-height: 1.65; max-width: 52ch; }
  .hero-links { display: flex; flex-wrap: wrap; gap: 20px; font-family: var(--fontMono); font-size: 13.5px; }
  .hero-links a { color: var(--accent); border-bottom: 1px solid color-mix(in srgb, var(--accent) 42%, transparent); padding-bottom: 2px; }
  .hero-links a:hover { border-bottom-color: var(--accent); }

  .hero-figure { display: flex; flex-direction: column; align-items: center; width: 100%; }
  .stage {
    position: relative; width: 100%; max-width: 470px; aspect-ratio: 470 / 340;
    border-radius: 10px; overflow: hidden; user-select: none; touch-action: pan-y;
  }
  canvas {
    display: block; width: 100%; height: 100%; cursor: grab;
    opacity: 0; transform: scale(.985);
    transition: opacity .65s cubic-bezier(.22, 1, .36, 1), transform .65s cubic-bezier(.22, 1, .36, 1);
  }
  canvas:active { cursor: grabbing; }
  canvas:global(.visible) { opacity: 1; transform: scale(1); }

  .term {
    position: absolute; top: 50%; left: 50%; width: min(388px, 92%); z-index: 2;
    background: var(--termBg); border: 1px solid var(--termRule); border-radius: 8px; overflow: hidden;
    box-shadow: 0 18px 40px -14px rgba(0, 0, 0, .32), 0 4px 12px -2px rgba(0, 0, 0, .18);
    transform: translate(-50%, -50%);
    transition: opacity .55s cubic-bezier(.22, 1, .36, 1), transform .55s cubic-bezier(.22, 1, .36, 1);
  }
  .term:global(.dissolving) { opacity: 0; transform: translate(-50%, -50%) scale(.95); pointer-events: none; }
  .term-bar {
    display: flex; align-items: center; justify-content: space-between; padding: 8px 12px;
    border-bottom: 1px solid var(--termRule); font-family: var(--fontMono); font-size: 11px; color: var(--termMuted);
  }
  .term-dots { display: inline-flex; gap: 6px; }
  .term-dots span { width: 8px; height: 8px; border-radius: 50%; opacity: .78; }
  .term-dots span:nth-child(1) { background: #EF4444; }
  .term-dots span:nth-child(2) { background: #F59E0B; }
  .term-dots span:nth-child(3) { background: #22C55E; }
  .term-body {
    padding: 15px 16px 17px; min-height: 88px; display: flex; flex-direction: column; justify-content: center; gap: 6px;
    font-family: var(--fontMono); font-size: 12.5px; line-height: 1.55; color: var(--termInk);
  }
  .term-line { white-space: pre-wrap; word-break: break-all; }
  .term-prompt { color: var(--termAccent); margin-right: 7px; font-weight: 600; }
  .term-cursor { display: inline-block; width: 7.5px; height: 14px; margin-left: 2px; vertical-align: -2px; background: var(--termAccent); animation: blink .72s steps(1, end) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  .term-out { font-size: 11.5px; color: var(--termMuted); min-height: 18px; opacity: 0; transform: translateY(2px); transition: opacity .2s ease, transform .2s ease; }
  .term-out:global(.shown) { opacity: 1; transform: none; }
  .term-ok { color: var(--termAccent); font-weight: 500; }

  .hud {
    position: absolute; left: 8px; right: 8px; bottom: 8px; z-index: 1;
    display: flex; align-items: center; justify-content: space-between; gap: 8px;
    pointer-events: none; opacity: 0; transition: opacity .4s ease;
  }
  .hud:global(.visible) { opacity: 1; }
  .hud-caption {
    font-family: var(--fontMono); font-size: 11px; color: var(--muted); padding: 3px 7px; border-radius: 5px;
    background: color-mix(in srgb, var(--bg) 82%, transparent); border: 1px solid color-mix(in srgb, var(--rule) 75%, transparent);
  }
  .hud-btn {
    pointer-events: auto; font-family: var(--fontMono); font-size: 11px; font-weight: 500; padding: 6px 10px; min-height: 30px;
    border-radius: 5px; background: var(--figBg); border: 1px solid var(--rule); color: var(--ink);
  }
  .hud-btn:hover { border-color: var(--accent); color: var(--accent); }

  .modes { width: 100%; max-width: 470px; margin-top: 12px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 6px; }
  .mode {
    font-family: var(--fontMono); font-size: 12px; text-align: left; padding: 8px 10px; min-height: 36px; border-radius: 6px;
    border: 1px solid var(--rule); background: var(--figBg); color: var(--muted);
    display: flex; align-items: center; justify-content: space-between; gap: 6px;
  }
  .mode:hover { color: var(--ink); }
  .mode:global(.active) { color: var(--accent); border-color: var(--accent); background: color-mix(in srgb, var(--accent) 7%, var(--figBg)); }
  .dot { width: 6px; height: 6px; border-radius: 50%; }
  .mode:global(.active) .dot { background: var(--accent); }
  .modes-foot { width: 100%; max-width: 470px; margin-top: 8px; display: flex; justify-content: space-between; align-items: center; font-family: var(--fontMono); font-size: 11px; color: var(--muted); }
  .replay { font-family: var(--fontMono); font-size: 11.5px; padding: 6px 10px; border-radius: 6px; border: 1px solid var(--rule); background: var(--figBg); }
  .replay:hover { border-color: var(--accent2); color: var(--accent2); }

  @media (prefers-reduced-motion: reduce) {
    .term-cursor { animation: none; }
  }
  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; gap: 32px; padding: 36px 0 42px; }
    .hero-figure { align-items: flex-start; }
  }
</style>
