---
import Icon from './Icon.astro';
import { site, nav } from '../data/site';
import { href, langFromPath, stripLang, useT } from '../i18n';

const lang = langFromPath(Astro.url.pathname);
const t = useT(lang);
const path = stripLang(Astro.url.pathname).replace(/\/$/, '') || '/';
const isCurrent = (p: string) => path === p || path.startsWith(p + '/');
---
<header class="site-header">
  <div class="container header-inner">
    <a href={href(lang, '/')} class="brand" aria-label={`${site.short}, ${t('header.home')}`}>
      <span class="brand-dot" aria-hidden="true"></span>
      <span>{site.short}</span>
    </a>

    <div class="nav-cluster">
      <nav class="nav-links" aria-label={t('nav.main')}>
        {nav.map((item) =>
          item.href ? (
            <a href={href(lang, item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>{t(item.key)}</a>
          ) : (
            <span class="nav-soon" title={t('nav.soonTitle')}>{t(item.key)} ({t('nav.soon')})</span>
          )
        )}
      </nav>

      <div class="header-actions">
        <a class="icon-btn" href={site.links.github} aria-label="GitHub" title="GitHub" target="_blank" rel="noopener noreferrer">
          <Icon name="github" />
        </a>
        <a class="icon-btn" href={site.links.linkedin} aria-label="LinkedIn" title="LinkedIn" target="_blank" rel="noopener noreferrer">
          <Icon name="linkedin" size={15} />
        </a>
        <button type="button" class="pill-btn" data-open-search aria-label={t('header.searchAria')}>
          <Icon name="search" size={14} />
          <span class="search-label">{t('header.search')}</span>
          <span class="kbd">⌘K</span>
        </button>
        <button type="button" class="icon-btn" data-theme-toggle aria-label={t('header.theme')} title={t('header.themeTitle')}>
          <span data-theme-icon="terminal"><Icon name="terminal" size={17} /></span>
          <span data-theme-icon="paper" hidden><Icon name="sun" size={17} /></span>
        </button>
      </div>
    </div>
  </div>
</header>

<script>
  // Theme toggle: the initial theme is set before paint by the inline script in Base.astro.
  const root = document.documentElement;
  const syncIcons = () => {
    const t = root.dataset.theme === 'terminal' ? 'terminal' : 'paper';
    document.querySelectorAll<HTMLElement>('[data-theme-icon]').forEach((el) => {
      // show the icon of the theme you'd switch TO
      el.hidden = el.dataset.themeIcon === t;
    });
  };
  syncIcons();
  document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
    const next = root.dataset.theme === 'terminal' ? 'paper' : 'terminal';
    root.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch {}
    syncIcons();
    window.dispatchEvent(new CustomEvent('themechange', { detail: next }));
  });
</script>
