---
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Search from '../components/layout/Search.astro';
import LangSwitch from '../components/layout/LangSwitch.astro';
import { site } from '../data/site';
import { alternate, langFromPath, ui } from '../i18n';

interface Props {
  title?: string;
  description?: string;
}
const lang = langFromPath(Astro.url.pathname);
const { title, description = site.description[lang] } = Astro.props;
const fullTitle = title ? `${title} · ${site.short}` : `${site.short}: ${site.tagline[lang]}`;
const path = Astro.url.pathname;
const abs = (p: string) => new URL(p, Astro.site ?? Astro.url).href;
---
<!doctype html>
<html lang={lang} data-theme="paper">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" hreflang="es" href={abs(alternate(path, 'es'))} />
    <link rel="alternate" hreflang="en" href={abs(alternate(path, 'en'))} />
    <link rel="alternate" hreflang="x-default" href={abs(alternate(path, 'es'))} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'es' ? 'es_CO' : 'en_US'} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap"
    />
    <!-- Set the theme before first paint (no flash). -->
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'terminal' || t === 'paper') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body>
    <a href="#main" class="sr-only">{ui[lang]['skip']}</a>
    <Header />
    <main id="main" class="container">
      <slot />
    </main>
    <Footer />
    <Search />
    <LangSwitch />
  </body>
</html>
