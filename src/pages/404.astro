---
// GitHub Pages serves a single 404 page for every language, so it's bilingual.
import Base from '../layouts/Base.astro';
---
<Base title="404">
  <header class="page-head">
    <div class="crumbs">$ cd {Astro.url.pathname}</div>
    <h1>404: no such file or directory</h1>
    <p>Esa página no existe. Vuelve al <a class="link" href="/">inicio</a> o presiona ⌘K para buscar.</p>
    <p lang="en">That page doesn't exist. Try <a class="link" href="/en">home</a>, or press ⌘K to search.</p>
  </header>
</Base>
